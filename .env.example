# Supabase project credentials (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional: email assigned Primary Admin when the first user signs up (also set in
# public.app_settings as primary_admin_email in Supabase; SQL seed docs explain).
PRIMARY_ADMIN_EMAIL=admin@example.com

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:admin@example.com

# Protects the weekly task recurrence endpoint. Configure the same value as a
# Vercel Cron Authorization header / CRON_SECRET environment variable.
CRON_SECRET=replace-with-a-long-random-secret
